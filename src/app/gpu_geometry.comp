#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer Packet { uint d[]; };
layout(set=0,binding=1,std430) readonly buffer Replacements { uint hi[]; };
layout(set=1,binding=0,rgba8) writeonly uniform image2D outputImage;
layout(set=2,binding=0,std140) uniform Params { uvec4 dimensions; uvec4 offsets; uvec4 layers; };
uint at(uint b,uint i) { return d[b+i]; }
uint byteAt(uint b,uint i) {return (at(b,i/4) >> ((i%4)*8))&255;}
uint wordAt(uint b,uint i) {return (at(b,i/2) >> ((i%2)*16))&65535;}
uint lerp(uint a,uint b,uint f) {return (a+(((b-a)*f)>>8))&0x00ff00ff;}
uint gamma(uint a) {return a<=64?0:((a-64)*255)/191;}
uint texel(uint sheet,uint bx,uint by,int x,int y) {
    int xx=int(bx)+x, yy=int(by)+y;
    if(xx>=1024) {xx-=1024;yy^=1024;}
    uint o=uint((yy/2)*512+xx/2);
    uint t=at(sheet,(o>>1)&0x7ffff);
    if((o&1)!=0)t>>=16;
    if((y&1)==0)t>>=8;
    if((x&1)==0)t>>=4;
    return (t&15)<<4;
}
uint wrap(int coordinate,uint size) {
    if((size&(size-1))==0)return uint(coordinate)&(size-1);
    return uint((coordinate%int(size)+int(size))%int(size));
}
uint sampleTexel(uint sheet,uint bx,uint by,int x,int y,uint w,uint h,uint sw,uint sh) {
    if(w!=sw)x=x*int(sw)/int(w);
    if(h!=sh)y=y*int(sh)/int(h);
    return texel(sheet,bx,by,x,y);
}
uint fetch(uint s,int level,int u,int v,bool cutout) {
    uint w=at(s,12),h=at(s,13),bx,by,sheet;
    int maxlevel=findMSB(int(min(w,h)))-1;
    if((dimensions.w&2)!=0 && level>=0)level=min(level+int((dimensions.w>>4)&3),maxlevel);
    uint primary=at(s,22)!=0?layers.y:layers.x;
    uint secondary=at(s,22)!=0?layers.x:layers.y;
    if(level==-1) {
        w=128;h=128;bx=at(s,20);by=at(s,21);sheet=secondary;
        u<<=1<<int(at(s,19)); v<<=1<<int(at(s,19));
    } else {
        w>>=level;h>>=level;bx=((at(s,14)-2048)>>level)&2047;by=((at(s,15)-1024)>>level)&1023;
        sheet=(level&1)!=0?secondary:primary;u>>=level;v>>=level;
    }
    uint flags=at(s,16);
    if((flags&4)!=0 && (u&int(w<<8))!=0)u=~u;
    if((flags&8)!=0 && (v&int(h<<8))!=0)v=~v;
    uint sw=w,sh=h;
    if(((dimensions.w>>4)&3)==3 && level>=0) {
        w=max(1,w*4/5);h=max(1,h*4/5);
        // Integer resampling avoids reciprocal rounding moving whole texels.
        u=(u/int(sw))*int(w)+(u%int(sw))*int(w)/int(sw);
        v=(v/int(sh))*int(h)+(v%int(sh))*int(h)/int(sh);
    }
    if((dimensions.w&4)!=0) {
        uint t=sampleTexel(sheet,bx,by,int(wrap(u>>8,w)),int(wrap(v>>8,h)),w,h,sw,sh);
        return cutout&&t!=240?t|0x00800000:t;
    }
    u-=128;v-=128;
    uint uf=uint(u)&255,vf=uint(v)&255;
    uint u0=wrap(u>>8,w),u1=wrap(int(u0+1),w),v0=wrap(v>>8,h),v1=wrap(int(v0+1),h);
    if((flags&1)==0&&u1==0) {if(uf>=128){u0=u1;u1++;uf=0;}else{u1=u0;u0--;uf=256;}}
    if((flags&2)==0&&v1==0) {if(vf>=128){v0=0;v1++;vf=0;}else{v1=v0;v0--;vf=256;}}
    uint a=sampleTexel(sheet,bx,by,int(u0),int(v0),w,h,sw,sh),b=sampleTexel(sheet,bx,by,int(u1),int(v0),w,h,sw,sh);
    uint c=sampleTexel(sheet,bx,by,int(u0),int(v1),w,h,sw,sh),e=sampleTexel(sheet,bx,by,int(u1),int(v1),w,h,sw,sh);
    if(cutout) {
        if(a!=240)a|=0x00800000;if(b!=240)b|=0x00800000;if(c!=240)c|=0x00800000;if(e!=240)e|=0x00800000;
        if(a==240)a=b&255;if(b==240)b=a&255;if(c==240)c=e&255;if(e==240)e=c&255;
    }
    uint ab=lerp(a,b,uf),ce=lerp(c,e,uf);
    if(cutout){if(ab==240)ab=ce&255;if(ce==240)ce=ab&255;}
    return lerp(ab,ce,vf);
}
const uint logtable[128]=uint[128](0,2,5,8,11,14,16,19,22,25,27,30,33,35,38,40,43,46,48,51,53,56,58,61,63,65,68,70,73,75,77,80,82,84,87,89,91,93,96,98,100,102,104,106,109,111,113,115,117,119,121,123,125,127,129,132,134,136,138,140,141,143,145,147,149,151,153,155,157,159,161,162,164,166,168,170,172,173,175,177,179,181,182,184,186,188,189,191,193,194,196,198,200,201,203,205,206,208,209,211,213,214,216,218,219,221,222,224,225,227,229,230,232,233,235,236,238,239,241,242,244,245,247,248,250,251,253,254);
int fastlog(float f) {if(f<0)return 0;uint i=floatBitsToUint(f)>>16;return ((int(i>>7)-127)<<8)|int(logtable[i&127]);}
int truncInt(float f) {return f>=-2147483648.0&&f<2147483648.0?int(f):int(0x80000000u);}
vec4 unpackColor(uint c) {return vec4((c>>16)&255,(c>>8)&255,c&255,c>>24)/255.0;}
vec4 repaintTexel(uint base,uint texel,uint mode) {
    if(mode==0)return unpackColor(hi[base+texel]);
    uint c=hi[base+texel/2]>>((texel&1)*16);
    return vec4(vec3(c&255),float((c>>8)&255))/255.0;
}
uint replacementColor(uint s,int u,int v,uint nativeColor,int mml,uint nativeIndex) {
    uint id=at(s,9)>>2;
    if(id==0)return nativeColor;
    uint base=hi[id*9],w=hi[id*9+1],h=hi[id*9+2],ow=hi[id*9+3],oh=hi[id*9+4];
    uint stride=hi[id*9+6],ox=hi[id*9+7],oy=hi[id*9+8];
    uint flags=at(s,16);
    if((flags&4)!=0&&(u&int(ow<<8))!=0)u=~u;
    if((flags&8)!=0&&(v&int(oh<<8))!=0)v=~v;
    vec2 uv=mod(vec2(u,v)/256.0*vec2(w,h)/vec2(ow,oh),vec2(w,h))-0.5;
    ivec2 p=ivec2(floor(uv));vec2 f=fract(uv);
    ivec2 a=p,b=p+ivec2(1);
    if((flags&1)!=0){a.x=int(wrap(a.x,w));b.x=int(wrap(b.x,w));}else{a.x=clamp(a.x,0,int(w)-1);b.x=clamp(b.x,0,int(w)-1);}
    if((flags&2)!=0){a.y=int(wrap(a.y,h));b.y=int(wrap(b.y,h));}else{a.y=clamp(a.y,0,int(h)-1);b.y=clamp(b.y,0,int(h)-1);}
    uint mode=hi[id*9+5];
    vec4 c=mix(mix(repaintTexel(base,(oy+uint(a.y))*stride+ox+uint(a.x),mode),repaintTexel(base,(oy+uint(a.y))*stride+ox+uint(b.x),mode),f.x),
               mix(repaintTexel(base,(oy+uint(b.y))*stride+ox+uint(a.x),mode),repaintTexel(base,(oy+uint(b.y))*stride+ox+uint(b.x),mode),f.x),f.y);
    if((mode==1 || mode==4) && at(s,8)==3) {
    vec4 samples[4];
    samples[0]=repaintTexel(base,(oy+uint(a.y))*stride+ox+uint(a.x),mode);
    samples[1]=repaintTexel(base,(oy+uint(a.y))*stride+ox+uint(b.x),mode);
    samples[2]=repaintTexel(base,(oy+uint(b.y))*stride+ox+uint(a.x),mode);
    samples[3]=repaintTexel(base,(oy+uint(b.y))*stride+ox+uint(b.x),mode);
    // Private test: remove void tones before interpolation, with a soft
    // transition to the live native tone rather than a cell-wide edge guard.
    if((mode==1 || mode==4) && at(s,8)==3) for(int i=0;i<4;i++) {
        float edge=smoothstep(208.0,224.0,samples[i].r*240.0);
        samples[i].r=mix(samples[i].r,float(nativeIndex)/240.0,edge);
    }
    c=mix(mix(samples[0],samples[1],f.x),mix(samples[2],samples[3],f.x),f.y);
    }
    // Keep source-matched repaints visible at any distance. Protected artwork
    // and native cutout coverage still control the replacement below.
    float amount=1.0;
    if(mode==2 || mode==3 || (mode==1 && (dimensions.w&128)!=0)) {
        // Private experiment: generated microdetail around live native index tones.
        // Neighbor alpha suppresses detail near protected boundaries; no asset edits.
        vec4 neighbors=vec4(0);float guard=1.0;
        for(int i=0;i<4;i++) {
            int radius=mode==3?1:6;
            ivec2 q=a+ivec2(i==0?-radius:(i==1?radius:0),i==2?-radius:(i==3?radius:0));
            q=clamp(q,ivec2(0),ivec2(int(w)-1,int(h)-1));
            vec4 n=repaintTexel(base,(oy+uint(q.y))*stride+ox+uint(q.x),mode);
            neighbors+=n;guard=min(guard,n.a);
        }
        float detail=clamp((c.r-neighbors.r*0.25)*240.0,-8.0,8.0);
        c.r=clamp((float(nativeIndex)+detail)/240.0,0.0,1.0);
        c.a*=guard;
    }
    // Source-guarded road material mode; aliases inherit the parent's mode.
    if(mode==4) {
        // Full coarse road contribution; original paint keeps native coverage.
        if(nativeIndex>=160u)c.a=0.0;
    }
    // Tool-only classification of matched samples that survive native coverage.
    if((dimensions.w&64)!=0) {
        if(amount==0.0)return 0xffff0000; // distance fade
        if(c.a==0.0)return 0xffff00ff; // protected/transparent sample
        return 0xff00ff00; // active repaint sample
    }
    amount*=c.a;
    vec3 shaded=c.rgb*float(at(s,18))/255.0;
    if(mode!=0) {
        // Repainted luminance fields retain all original palette variants.
        uint t=uint(clamp(c.r*240.0+0.5,0.0,240.0));
        // Index 15 is a cutout marker, never repainted opaque artwork.
        // Keep native edge shading where generated white voids drift inward.
        if(at(s,8)==3)amount*=1.0-smoothstep(224.0,240.0,c.r*240.0);
        uint luma=min((byteAt(offsets.w,(at(s,10)+(t>>1))*4)*at(s,18)/256)&255,63);
        uint pal=wordAt(offsets.y,at(s,11)+4096);
        shaded=vec3(gamma(wordAt(offsets.z,((pal&31)<<8)+luma)&255),
                    gamma(wordAt(offsets.z,8192+(((pal>>5)&31)<<8)+luma)&255),
                    gamma(wordAt(offsets.z,16384+(((pal>>10)&31)<<8)+luma)&255))/255.0;
    }
    vec3 result=mix(unpackColor(nativeColor).rgb,shaded,amount);
    uvec3 rgb=uvec3(clamp(result*255.0+0.5,vec3(0),vec3(255)));
    return 0xff000000|(rgb.r<<16)|(rgb.g<<8)|rgb.b;
}
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    uint width=dimensions.x,height=dimensions.y;
    if(xy.x>=width||xy.y>=height)return;
    uint x=xy.x,y=xy.y;
    uint sy=y*384/height,sx=x*496/width;
    int hx=(dimensions.w&8)!=0?int(floor((float(x)-float(width)/8.0)*496.0/(float(width)*0.75))):int(sx);
    uint front=hx>=0&&hx<496?at(layers.w,sy*496+uint(hx)):0;
    uint color=0,window=0;float depth=0;
    if(front==0) {
      uint first=at(dimensions.z,y),last=at(dimensions.z,y+1);
      for(uint n=first;n<last;n++) {
        uint s=offsets.x+n*24;
        uint x0=at(s,0),x1=at(s,1),renderer=at(s,8),flags=at(s,9),win=at(s,23);
        if(x<x0||x>=x1||((flags&1)!=0&&((x^y)&1)==0))continue;
        precise float inv=uintBitsToFloat(at(s,2))+float(x-x0)*uintBitsToFloat(at(s,5));
        bool depthEnabled=(dimensions.w&1)!=0;
        if(depthEnabled) {
            if(!(inv>0)||isinf(inv)||isnan(inv))continue;
            if(color!=0&&(win<window||(win==window&&inv<=depth*1.001)))continue;
        } else if(color!=0)break;
        uint luma=at(s,18)>>2;
        int texture_u=0,texture_v=0,texture_mml=128;uint texture_index=0;
        if(renderer>=2) {
            precise float uoz=uintBitsToFloat(at(s,3))+float(x-x0)*uintBitsToFloat(at(s,6));
            precise float voz=uintBitsToFloat(at(s,4))+float(x-x0)*uintBitsToFloat(at(s,7));
            float z=1.0/inv;int mml=-int(at(s,17))+fastlog(z);
            int maxlevel=findMSB(int(min(at(s,12),at(s,13))))-1;
            int level=clamp(mml>>7,0,maxlevel),u=truncInt(uoz*z*256.0),v=truncInt(voz*z*256.0);
            texture_u=u;texture_v=v;texture_mml=mml;
            bool cutout=renderer==3;uint t=fetch(s,level,u,v,cutout);
            if((dimensions.w&2)==0) {
                if(mml>0&&level<maxlevel)t=lerp(t,fetch(s,level+1,u,v,cutout),uint((mml&127)<<1));
                else if((flags&2)!=0&&mml<0)t=lerp(t,fetch(s,-1,u,v,cutout),uint(min((-mml)>>int(at(s,19)),127)));
            }
            if(cutout){if(t<0x00400000)continue;t&=255;}
            texture_index=t;
            luma=min((byteAt(offsets.w,(at(s,10)+(t>>1))*4)*at(s,18)/256)&255,63);
        }
        uint pal=wordAt(offsets.y,at(s,11)+4096);
        uint r=gamma(wordAt(offsets.z,((pal&31)<<8)+luma)&255);
        uint g=gamma(wordAt(offsets.z,8192+(((pal>>5)&31)<<8)+luma)&255);
        uint b=gamma(wordAt(offsets.z,16384+(((pal>>10)&31)<<8)+luma)&255);
        color=0xff000000|(r<<16)|(g<<8)|b;
        if(renderer>=2)color=replacementColor(s,texture_u,texture_v,color,texture_mml,texture_index);
        depth=inv;window=win;
      }
    }
    if(front!=0)color=front;else if(color==0)color=at(layers.z,sy*496+sx);
    imageStore(outputImage,ivec2(xy),vec4(float((color>>16)&255),float((color>>8)&255),float(color&255),255)/255.0);
}

